# App
APP_NAME=AI Database Analyst
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI model (do not change - only qwen3:8b is supported)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_REQUEST_TIMEOUT_S=120

# SQL Server connection - the only place this app reads DB credentials from.
# Use a READ-ONLY login (see README: "Creating a read-only login").
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
